/*
 * `.boot` is loaded and runs at 16 MiB; the rest is loaded right after it
 * and runs at the kernel map base above it, KERNEL_BASE.
 */
KERNEL_MAP_BASE = 0xffffffff80000000;

ENTRY(boot_start)
SECTIONS
{
  . = 0x1000000;
  .boot : { *(.boot.text) *(.boot.data) }

  . += KERNEL_MAP_BASE;
  /* Text starts on a page boundary, so no page holds both .boot and text. */
  . = ALIGN(4096);
  text_start = .;
  .text : AT(ADDR(.text) - KERNEL_MAP_BASE) { *(.text .text.*) }
  /* Text ends on a page boundary, so its pages map read-only. */
  . = ALIGN(4096);
  text_end = .;
  .rodata : AT(ADDR(.rodata) - KERNEL_MAP_BASE) { *(.rodata .rodata.*) }
  /* Rodata and .got end on a page boundary, so their pages map read-only. */
  . = ALIGN(4096);
  rodata_end = .;
  .data : AT(ADDR(.data) - KERNEL_MAP_BASE) { *(.data .data.*) }
  .bss : AT(ADDR(.bss) - KERNEL_MAP_BASE) { *(.bss .bss.*) *(COMMON) }
  _end = .;
}
